# Copy to .env.local for local development, and add the same names in Vercel → Project → Settings → Environment Variables.
# These three values are PUBLIC by design (they are visible in the browser). Data is protected by Supabase row-level security.
# NEVER add the Supabase service_role / secret key or the database password here or in any NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://ampqwmgfltcauwnmxbtm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # Supabase → Project Settings → API Keys → publishable key
NEXT_PUBLIC_SITE_URL=http://localhost:3000                # your live address, e.g. https://www.mnmt.co.zm (no trailing slash)
